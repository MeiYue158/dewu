{
  "note": "品类知识库：场景 → 推导约束。铁律是模型不得凭自身知识推导约束，只能查这张表；查不到就追问，不许猜。每条 derive 的字段都会在加载时用 field-schema.json 校验，目录答不了的字段写不进来。",
  "state_fields": {
    "occasion": {
      "domain": ["gift", "self"],
      "note": "场合不是商品字段，只存在于会话状态；它是 derived 约束的源字段。"
    },
    "recipient": {
      "domain": ["partner", "parent", "friend", "self"],
      "note": "送礼对象，用于后续礼物先验；目前只参与状态，不直接过滤。"
    },
    "digital_use": {
      "domain": ["commute", "work", "travel"],
      "note": "数码使用场景。"
    }
  },
  "vague_terms": {
    "note": "相对表述必须 anchor 到上下文里的具体数值才能变成查询条件；没有锚点就不能推导，只能追问。比例是待定的产品决策（对应 03-open-questions Q3），写在这里是为了可改、可审计。",
    "terms": [
      {"id": "VT-01", "phrases": ["便宜点", "便宜一点", "再便宜", "有没有便宜的"],
       "field": "price_cny", "op": "<=", "anchor_ratio": 0.7},
      {"id": "VT-02", "phrases": ["贵一点", "好一点的", "再好点"],
       "field": "price_cny", "op": ">=", "anchor_ratio": 1.3},
      {"id": "VT-03", "phrases": ["差不多价位", "同价位", "类似价格"],
       "field": "price_cny", "op": "BETWEEN", "anchor_ratio": [0.8, 1.2]}
    ]
  },
  "rules": [
    {
      "id": "SR-G01",
      "scene": "gift/jewelry",
      "triggers": ["送女朋友", "送女友", "送老婆", "送媳妇", "送妈妈", "送女生",
                   "生日礼物", "情人节", "纪念日", "送礼", "求婚", "表白"],
      "state": {"occasion": "gift"},
      "derive": [
        {"field": "category", "op": "IN",
         "value": ["项链", "手链", "戒指", "耳钉", "项坠/吊坠", "耳环", "手镯"],
         "evidence": "目录中可作礼品的首饰类目共 7 个，79/121 件商品落在其中"}
      ]
    },
    {
      "id": "SR-G02",
      "scene": "gift/boxed",
      "triggers": ["要礼盒", "带包装", "包装好看", "送人的包装"],
      "state": {"occasion": "gift"},
      "derive": [
        {"field": "礼盒", "op": "CONTAINS", "value": "盒",
         "evidence": "礼盒是 SKU 维度，120/673 个 SKU 声明；覆盖率不足以做硬过滤，仅参与排序"}
      ]
    },
