__pycache__/
.idea/
.DS_Store
.pytest_cache/

# secrets: ignore every .env variant, keep only the template
.env
.env.*
!.env.example


data/*.sqlite3
*.sqlite3
*.sqlite3-journal
qdrant_storage/
runs/
*.log

# ─────────────────────────────────────────────────────────────
# data, not code. everything below is either raw input we were
# given, or something a script regenerates from it. keeping it
# out so the repo reads as a design, not as a data dump.
#
# to rebuild after cloning (needs the raw snapshots in place):
#   uv run python scripts/prepare_products.py
#   uv run python scripts/synthesize_products.py
#   uv run python scripts/prepare_products.py --source fixtures/raw/poizon \
#       fixtures/raw/synthetic --overlay fixtures/synthetic/overlay.json \
#       --output fixtures/catalog
#   uv run python scripts/derive_schema.py
#   uv run --env-file .env python scripts/embed_products.py
# ─────────────────────────────────────────────────────────────

# raw snapshots - provenance is unclear, so these never leave the machine
fixtures/raw/

# generated by synthesize_products.py
fixtures/synthetic/overlay.json

# normalised exports, rebuilt by prepare_products.py
fixtures/*/products.jsonl
fixtures/*/es.bulk.jsonl
fixtures/*/qdrant.inputs.jsonl

# embeddings - 7.9 MB of floats nobody reads in a review
fixtures/*/vectors/

# eval output, changes on every run and makes noisy diffs
fixtures/eval/*-report.json

# evidence of one-off import runs
docs/evidence/
