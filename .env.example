# 本文件可提交到 Git；真实配置填写到 .env（已忽略）。
# 已有 .env 时只补充缺少的字段，不要直接覆盖。
# 加载方式：uv run --env-file .env <命令>
# 例如：uv run --env-file .env uvicorn backend.main:app --reload

# ── OpenAI / 兼容服务（预留：真实聊天与 FC 调用尚未接入）──
# 地址包含 /v1；填写服务实际支持的模型名称。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Embedding（已接入：文档和查询必须使用同一模型）──
# 本地 Ollama OpenAI 兼容接口；ollama 为本地占位 key。
# 独立于聊天服务的地址、key 和模型，不要共用 OPENAI_MODEL。
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=quentinz/bge-small-zh-v1.5
# 当前 all-minilm 实测384维；集合配置由导出脚本按实际维度生成。
# 修改模型后需重新生成商品向量。
# 维度留空表示沿用上面的"按实际维度生成"；填写则在写入前做一次断言，
# 防止换模型后忘记重建集合——维度不匹配会报错，但语义空间不匹配不会报错。
EMBEDDING_DIM=512

# ── Elasticsearch（预留：应用检索适配器尚未接入）──
ES_URL=http://localhost:9200
ES_INDEX=poizon_products_v1
# 无认证时留空；API key 与用户名密码二选一，不要同时填写。
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
# HTTPS 自签证书环境填写 CA 文件路径。
ES_CA_CERT=

# ── Qdrant（预留：应用检索适配器尚未接入）──
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=poizon_products_v1

# ── PostgreSQL（预留：结构化召回路尚未接入）──
# 承载硬条件查询：预算、品类、尺码、是否有货；价格与库存以此库为准，
# ES 和 Qdrant 中的同名字段只是检索副本。
# 本机 5432 常被其他服务占用，默认映射到 5434。
PG_DSN=postgresql://USER:PASSWORD@localhost:5434/poizon

# ── 召回与融合（预留：三路召回与 RRF 尚未接入）──
# 每一路各自返回的候选数量。
RECALL_SIZE=10
# 融合后交给模型的商品数量。
FINAL_TOP_K=4
# 向量检索永远返回最近邻，低于该余弦相似度的结果在融合前丢弃。
VECTOR_SCORE_THRESHOLD=0.35
# RRF 常数，出自原论文：score = Σ 权重 / (RRF_K + 该路名次)。
# 调大会压平第 1 名和第 10 名的差距，避免单路因为过度自信而主导排序。
RRF_K=60
# 各路权重。ES 与向量都在衡量相关性，记满分；结构化路按销量排序、
# 不代表相关性，压到 0.5，只允许把热门且符合硬条件的商品往上顶一点。
SOURCE_WEIGHT_ES=1.0
SOURCE_WEIGHT_VECTOR=2.0
SOURCE_WEIGHT_PG=0.5

# ── 本地会话存储（已接入）──
# 相对路径基于启动命令的工作目录；建议在项目根目录运行。
CHAT_DB_PATH=./data/chat.sqlite3
# 每次请求回传给模型的最近轮数（一轮 = 用户一条 + 助手一条）。
# 全量历史每轮都会重发，不设上限会让长会话越来越慢、越来越贵。
MAX_HISTORY_TURNS=6
